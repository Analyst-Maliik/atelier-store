# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Required. Signs auth tokens and cookies, so a guessable value allows forged
# tokens. The app refuses to start unless it is 32+ characters and non-trivial.
# Generate with: openssl rand -base64 32
# Use a different value per environment and never reuse one that was shared.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
